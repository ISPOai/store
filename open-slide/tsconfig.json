{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/app/*"],
      "virtual:open-slide/slides": ["./src/virtual/slides.ts"],
      "virtual:open-slide/config": ["./src/virtual/config.ts"],
      "virtual:open-slide/folders": ["./src/virtual/folders.ts"],
      "virtual:open-slide/themes": ["./src/virtual/themes.ts"]
    }
  },
  "include": ["src"]
}
