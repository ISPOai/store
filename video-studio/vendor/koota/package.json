{
  "name": "koota",
  "version": "0.6.6",
  "description": "🌎 Performant real-time state management for TypeScript and React",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "https://github.com/pmndrs/koota"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": {
        "import": "./dist/index.d.ts",
        "require": "./dist/index.d.cts"
      },
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./react": {
      "types": {
        "import": "./dist/react.d.ts",
        "require": "./dist/react.d.cts"
      },
      "import": "./dist/react.js",
      "require": "./dist/react.cjs"
    }
  },
  "files": [
    "dist",
    "react",
    "README.md",
    "LICENSE"
  ],
  "peerDependencies": {
    "@types/react": ">=18.0.0",
    "react": ">=18.0.0"
  },
  "peerDependenciesMeta": {
    "@types/react": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "module": "./dist/index.js"
}